{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "morphi-one",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["nodejs_als"],
	"workers_dev": true,
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "morphi-accounts-local",
			"database_id": "local-morphi-accounts",
			"migrations_dir": "migrations",
			"remote": false
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONFIG_CACHE",
			"id": "local-morphi-config-cache",
			"remote": false
		}
	],
	"r2_buckets": [
		{
			"binding": "RUN_ARCHIVE",
			"bucket_name": "morphi-run-archive",
			"remote": false
		}
	],
	"env": {
		"cron": {
			"name": "morphi-one-cron",
			"main": "workers/cron.ts",
			"workers_dev": false,
			"vars": { "BETTER_AUTH_URL": "http://localhost:5173" },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "morphi-accounts-local",
					"database_id": "local-morphi-accounts",
					"migrations_dir": "migrations",
					"remote": false
				}
			],
			"kv_namespaces": [
				{
					"binding": "CONFIG_CACHE",
					"id": "local-morphi-config-cache",
					"remote": false
				}
			],
			"r2_buckets": [
				{
					"binding": "RUN_ARCHIVE",
					"bucket_name": "morphi-run-archive",
					"remote": false
				}
			],
			"triggers": { "crons": ["*/5 * * * *", "0 0 * * *", "0 0 1 * *"] }
		}
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"redact_query_string": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
	// Add a custom domain only after morphi.one is an active Cloudflare zone:
	// "routes": [{ "pattern": "morphi.one", "custom_domain": true }]
}
