{
	"name": "morphi-one",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/finish-build.ts",
		"prepare:public-privacy": "bun scripts/prepare-public-privacy.ts",
		"test:public-privacy": "bun scripts/check-public-privacy.ts",
		"preview": "vite preview",
		"prepare": "bun run registry:generate && wrangler types && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "bun run db:migrate:local && playwright test",
		"deploy": "bun run build && wrangler deploy",
		"deploy:dry": "bun run build && wrangler deploy --dry-run",
		"preview:worker": "bun run build && wrangler dev",
		"cf:whoami": "wrangler whoami",
		"cf:types": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"accounts:setup": "bun scripts/setup-accounts.ts",
		"test:accounts": "vitest run --config vitest.accounts.config.ts",
		"registry:generate": "bun scripts/generate-registry.ts",
		"admin:local": "bun scripts/admin-local.ts",
		"test:vectors": "bun scripts/check-vectors.ts",
		"test:worker": "bun run build && bun scripts/check-worker.ts",
		"measure:replay": "bun scripts/measure-replay.ts",
		"check:boundaries": "bun scripts/check-boundaries.ts",
		"check:lazy-bundle": "bun scripts/check-lazy-bundle.ts",
		"test:palettes": "bun scripts/check-palettes.ts",
		"theme:sheet": "bun scripts/theme-sheet.ts",
		"verify": "bun run lint && bun run check && bun run check:boundaries && bun run test:palettes && bun run test:unit -- --run && bun run test:accounts && bun run test:vectors && bun run test:worker && bun run check:lazy-bundle && bun run test:e2e",
		"demo:motion": "bun scripts/build-demo-motion.ts",
		"demo:card": "bun scripts/build-card-proof.ts",
		"test:demo": "bun scripts/check-v1-demo.ts",
		"sounds:generate": "bun scripts/generate-sounds.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"animejs": "4.5.0",
		"drizzle-kit": "0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "4.151.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.12",
		"@elevenlabs/elevenlabs-js": "^2.74.0",
		"@fontsource-variable/nunito": "5.3.0",
		"better-auth": "1.7.12",
		"drizzle-orm": "0.45.4"
	}
}
